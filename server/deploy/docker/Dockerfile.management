FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ rsync \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/local/freeplay
COPY src/package*.json ./
RUN npm ci --omit=dev
COPY src/management/ ./management/
COPY deploy/db/management.sql /opt/freeplay/db/management.sql
ENV FREEPLAY_CONFIG=/usr/local/freeplay/config.json \
    FREEPLAY_MANAGEMENT_SCHEMA=/opt/freeplay/db/management.sql
USER node
CMD ["node", "management/worker.js"]
